{
  "name": "smart-cc-recommendations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test-scraper": "npx tsx test-scraper.ts",
    "test:units": "npx tsx lib/recommendation/categoryMapper.test.ts && npx tsx lib/recommendation/creditsCalculator.test.ts && npx tsx lib/recommendation/benefitsCalculator.test.ts && npx tsx lib/recommendation/rewardsCalculator.test.ts && npx tsx lib/recommendation/cardValueCalculator.test.ts && npx tsx lib/recommendation/spendingAllocator.test.ts && npx tsx lib/recommendation/cardFilter.test.ts",
    "test:engine": "npx tsx lib/recommendationEngine.test.ts",
    "test:all": "npm run test:units && npm run test:engine",
    "research:cards": "npx tsx scripts/research-cards.ts",
    "validate:cards": "npx tsx scripts/validate-card.ts",
    "merge:cards": "npx tsx scripts/merge-cards.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "15.5.2",
    "ollama": "^0.6.0",
    "plaid": "^38.1.0",
    "playwright": "^1.56.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-plaid-link": "^4.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "openai": "^6.24.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
